PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# 1. Sign up on https://cloud.mongodb.com/ (Free M0 Cluster)
# 2. Add Network Access: 0.0.0.0/0 (allow access from anywhere for Render)
# 3. Create a Database User with readWrite permissions
# 4. Copy connection string and paste here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lumina_tasks?retryWrites=true&w=majority

# JWT Authentication Secret Key (generate a strong random string)
JWT_SECRET=lumina_task_jwt_super_secret_key_2026_xyz

# Netlify Frontend URL (used by CORS to allow browser requests)
# Make sure NOT to include a trailing slash!
FRONTEND_URL=https://luminataskmanagement.netlify.app
